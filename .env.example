# Copy to .env and fill in only the provider you want to use.
# Nothing here is required: the default provider is the offline mock.

# Select the provider used by the app under test (mock | openai | azure_openai | bedrock)
LLM_EVAL_PROVIDER=mock
# Optional: use a different provider for the LLM-as-judge (defaults to the mock judge)
LLM_EVAL_JUDGE_PROVIDER=mock

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-06-01

# AWS Bedrock (credentials are resolved by the standard AWS chain: env, profile, SSO, role)
AWS_REGION=eu-west-2
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
